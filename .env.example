# Copy to .env for local development. Never commit real credentials.

DATABASE_URL="postgresql://postgres@localhost:5432/rentcert_development"
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/rentcert_test"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email: "console" prints emails to the server log; "file" writes tmp/mail/*.json; "ses" sends
# through Amazon SES (production; uses AWS_REGION and the AWS credential chain).
EMAIL_PROVIDER="console"
MAILER_FROM="RentCert <no-reply@rentcert.local>"
EMAIL_PROVIDER_API_KEY=""

# Days before a due date that a check counts as "due soon" (default 30).
COMPLIANCE_DUE_SOON_DAYS="30"

# Document storage: "local" (files under STORAGE_LOCAL_PATH) or "s3" (private bucket).
STORAGE_DRIVER="local"
# Background jobs: "pgboss" (default; run `npm run worker`) or "inline" (tests only).
QUEUE_DRIVER="pgboss"

# Stripe (hosted Checkout, no card forms). Use test-mode keys locally.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""   # from `stripe listen` locally, or the dashboard endpoint in production
STRIPE_PRICE_PROPERTY=""   # price id for $9 AUD/month, 1 property
STRIPE_PRICE_PORTFOLIO=""  # price id for $19 AUD/month, up to 5 properties
STORAGE_LOCAL_PATH="storage"
# Used when STORAGE_DRIVER=s3. Credentials come from the standard AWS chain (instance/task role).
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET=""

# Observability. Sentry stays off until the DSNs are set.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""        # CI only, for source map upload
ALERT_EMAIL=""              # receives background-job alerts
LOG_LEVEL="info"

# Production only: kamal-proxy's Docker network, so rate limits use the real client IP.
TRUSTED_PROXY_CIDRS=""
# Production only: /api/health also requires a fresh worker heartbeat.
HEALTH_CHECK_WORKER="false"
