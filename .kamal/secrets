# Secrets for Kamal, fetched at deploy time from SSM Parameter Store (/rentcert/prod/*).
# No secret values live in this repository. Uses the AWS credentials of whoever deploys:
# AWS_PROFILE=rentcert locally, or the GitHub OIDC role in CI.
PARAMS=$(aws ssm get-parameters-by-path --region ap-southeast-2 --path /rentcert/prod --with-decryption \
  --query 'Parameters[].[Name,Value]' --output text)
param() { printf '%s\n' "$PARAMS" | awk -F '\t' -v name="/rentcert/prod/$1" '$1 == name { print $2 }'; }

DATABASE_URL=$(param DATABASE_URL)
POSTGRES_PASSWORD=$(param POSTGRES_PASSWORD)
AWS_S3_BUCKET=$(param AWS_S3_BUCKET)
AWS_BACKUP_BUCKET=$(param AWS_BACKUP_BUCKET)
MAILER_FROM=$(param MAILER_FROM)
BETTER_AUTH_URL=$(param BETTER_AUTH_URL)
BETTER_AUTH_SECRET=$(param BETTER_AUTH_SECRET)
STRIPE_SECRET_KEY=$(param STRIPE_SECRET_KEY)
STRIPE_WEBHOOK_SECRET=$(param STRIPE_WEBHOOK_SECRET)
STRIPE_PRICE_PROPERTY=$(param STRIPE_PRICE_PROPERTY)
STRIPE_PRICE_PORTFOLIO=$(param STRIPE_PRICE_PORTFOLIO)
SENTRY_DSN=$(param SENTRY_DSN)
ALERT_EMAIL=$(param ALERT_EMAIL)

# ECR login token, valid for 12 hours.
KAMAL_REGISTRY_PASSWORD=$(aws ecr get-login-password --region ap-southeast-2)
