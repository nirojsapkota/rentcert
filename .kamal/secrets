# Secrets for Kamal, fetched at deploy time. No secret values live in this repository.
# Uses the AWS credentials of whoever deploys: AWS_PROFILE=rentcert locally, or the GitHub
# OIDC role in CI.
#   rentcert/prod/infra - written by Terraform (database URL, bucket, mail sender)
#   rentcert/prod/app   - filled in by you (auth secret, Stripe, Sentry, alert email)
SECRETS=$(kamal secrets fetch --adapter aws_secrets_manager rentcert/prod/infra rentcert/prod/app)

DATABASE_URL=$(kamal secrets extract rentcert/prod/infra/DATABASE_URL ${SECRETS})
AWS_S3_BUCKET=$(kamal secrets extract rentcert/prod/infra/AWS_S3_BUCKET ${SECRETS})
MAILER_FROM=$(kamal secrets extract rentcert/prod/infra/MAILER_FROM ${SECRETS})
BETTER_AUTH_URL=$(kamal secrets extract rentcert/prod/infra/BETTER_AUTH_URL ${SECRETS})

BETTER_AUTH_SECRET=$(kamal secrets extract rentcert/prod/app/BETTER_AUTH_SECRET ${SECRETS})
STRIPE_SECRET_KEY=$(kamal secrets extract rentcert/prod/app/STRIPE_SECRET_KEY ${SECRETS})
STRIPE_WEBHOOK_SECRET=$(kamal secrets extract rentcert/prod/app/STRIPE_WEBHOOK_SECRET ${SECRETS})
STRIPE_PRICE_PROPERTY=$(kamal secrets extract rentcert/prod/app/STRIPE_PRICE_PROPERTY ${SECRETS})
STRIPE_PRICE_PORTFOLIO=$(kamal secrets extract rentcert/prod/app/STRIPE_PRICE_PORTFOLIO ${SECRETS})
SENTRY_DSN=$(kamal secrets extract rentcert/prod/app/SENTRY_DSN ${SECRETS})
ALERT_EMAIL=$(kamal secrets extract rentcert/prod/app/ALERT_EMAIL ${SECRETS})

# ECR login token, valid for 12 hours.
KAMAL_REGISTRY_PASSWORD=$(aws ecr get-login-password --region ap-southeast-2)
