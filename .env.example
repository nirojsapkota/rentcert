# Copy to .env for local development. Never commit real credentials.

DATABASE_URL="postgresql://postgres@localhost:5432/rentcert_development"
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/rentcert_test"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email: "console" prints emails to the server log. Production providers arrive in Phase 5.
EMAIL_PROVIDER="console"
MAILER_FROM="RentCert <no-reply@rentcert.local>"
EMAIL_PROVIDER_API_KEY=""

# Days before a due date that a check counts as "due soon" (default 30).
COMPLIANCE_DUE_SOON_DAYS="30"
