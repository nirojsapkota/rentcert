// RentCert data model.
// Tables and columns use snake_case in PostgreSQL; Prisma fields stay camelCase.
// User, Session, Account, Verification and RateLimit follow the Better Auth core schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id
  name              String
  email             String   @unique
  emailVerified     Boolean  @default(false) @map("email_verified")
  image             String?
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  timezone          String   @default("Australia/Melbourne")
  notificationEmail String?  @map("notification_email")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  auditEvents AuditEvent[]
  properties  Property[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// Append-only record of changes to user data. Never store document contents here.
model AuditEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  action       String
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

// Timestamp-only log kept after an account is deleted. Holds no personal data.
model AccountDeletion {
  id        String   @id @default(uuid(7)) @db.Uuid
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@map("account_deletions")
}

enum AustralianState {
  NSW
  VIC
  QLD
  SA
  WA
  TAS
  NT
  ACT
}

// A rental property. Active while archivedAt is null.
// Migration adds CHECK (postcode ~ '^[0-9]{4}$' AND postcode >= '0200').
model Property {
  id             String          @id @default(uuid(7)) @db.Uuid
  userId         String          @map("user_id")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine1   String          @map("address_line_1")
  addressLine2   String?         @map("address_line_2")
  suburb         String
  state          AustralianState
  postcode       String
  nickname       String?
  notes          String?
  leaseStartDate DateTime?       @map("lease_start_date") @db.Date
  archivedAt     DateTime?       @map("archived_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  complianceRecords     ComplianceRecord[]
  requirementExclusions PropertyRequirementExclusion[]

  @@index([userId, archivedAt, createdAt])
  @@map("properties")
}

// Configuration: what must happen and how often, per jurisdiction ("VIC", or "GENERIC" for the
// unresearched fallback). Rows are seeded by migration; last_verified_at stays null until a person verifies them.
model ComplianceRequirement {
  id               String    @id @default(uuid(7)) @db.Uuid
  code             String
  jurisdiction     String
  name             String
  description      String
  recurrenceMonths Int       @map("recurrence_months")
  sortOrder        Int       @map("sort_order")
  active           Boolean   @default(true)
  sourceName       String?   @map("source_name")
  sourceUrl        String?   @map("source_url")
  lastVerifiedAt   DateTime? @map("last_verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  records ComplianceRecord[]

  @@unique([jurisdiction, code])
  @@map("compliance_requirements")
}

enum ComplianceRecordKind {
  COMPLETED
  UNKNOWN_LAST_CHECK
}

// An event: a check done at a property, or the "last check unknown" starting point.
// Migration adds CHECK (kind <> 'COMPLETED' OR completed_on IS NOT NULL).
model ComplianceRecord {
  id                    String                @id @default(uuid(7)) @db.Uuid
  propertyId            String                @map("property_id") @db.Uuid
  property              Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requirementId         String                @map("requirement_id") @db.Uuid
  requirement           ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  kind                  ComplianceRecordKind
  completedOn           DateTime?             @map("completed_on") @db.Date
  nextDueOn             DateTime              @map("next_due_on") @db.Date
  providerName          String?               @map("provider_name")
  providerLicenceNumber String?               @map("provider_licence_number")
  notes                 String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  documents ComplianceDocument[]

  @@index([propertyId, requirementId, nextDueOn])
  @@index([requirementId])
  @@index([nextDueOn])
  @@map("compliance_records")
}

// A requirement code the owner marked "not applicable" for one property (for example no gas).
model PropertyRequirementExclusion {
  propertyId      String   @map("property_id") @db.Uuid
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requirementCode String   @map("requirement_code")
  createdAt       DateTime @default(now()) @map("created_at")

  @@id([propertyId, requirementCode])
  @@map("property_requirement_exclusions")
}

enum ScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
}

// An uploaded certificate or report. The file lives in object storage under storage_key
// (documents/<userId>/<uuid>); the key never contains the filename.
// Migration adds CHECK constraints on byte_size (1..10 MB) and content_type (PDF, JPEG, PNG).
model ComplianceDocument {
  id                 String           @id @default(uuid(7)) @db.Uuid
  complianceRecordId String           @map("compliance_record_id") @db.Uuid
  complianceRecord   ComplianceRecord @relation(fields: [complianceRecordId], references: [id], onDelete: Cascade)
  filename           String
  contentType        String           @map("content_type")
  byteSize           Int              @map("byte_size")
  sha256             String
  storageKey         String           @unique @map("storage_key")
  scanStatus         ScanStatus       @default(NOT_SCANNED) @map("scan_status")
  uploadedAt         DateTime         @default(now()) @map("uploaded_at")

  @@index([complianceRecordId, uploadedAt])
  @@map("compliance_documents")
}
